{
  "name": "mochi-language",
  "version": "1.0.0",
  "description": "A living desktop language companion: tiny games, a growing memory garden, and spaced retrieval.",
  "author": "Mochi Contributors",
  "license": "MIT",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "lint": "node --check main.cjs && node --check preload.cjs && node --check ui/mochi.js && node --check ui/memory.js && node --check ui/lessons.js",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm test",
    "test:desktop": "node tests/desktop.cjs",
    "test:widget": "node tests/desktop.cjs",
    "test:screenshots": "node tests/desktop.cjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "org.mochi.language",
    "productName": "Mochi",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "shortcutName": "Mochi",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "uninstallDisplayName": "Mochi Language",
      "artifactName": "Mochi-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "category": "Education",
      "icon": "assets/icon.png"
    },
    "asarUnpack": [
      "assets/*"
    ],
    "portable": {
      "artifactName": "Mochi-Portable-${version}.${ext}"
    }
  }
}
