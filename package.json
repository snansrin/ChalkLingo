{
  "name": "chalklingo",
  "version": "0.3.0",
  "description": "A research-informed interactive chalkboard language tutor with optional local LLM",
  "author": "ChalkLingo Contributors",
  "license": "MIT",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "lint": "node --check main.cjs && node --check preload.cjs && node --check ui/lessons.js && node --check ui/engine.js && node --check ui/tutor.js && node --check ui/tutor-ui.js && node --check ui/ollama-bridge.cjs && node --check ui/app.js && node --check ui/rhythm.js && node --check ui/audio.js",
    "check": "npm run lint && npm test",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "test:desktop": "node tests/desktop.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "org.chalklingo.desktop",
    "productName": "ChalkLingo",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "category": "Education",
      "icon": "assets/icon.png"
    },
    "asarUnpack": [
      "assets/*"
    ]
  }
}
