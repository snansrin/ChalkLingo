{
  "name": "chalklingo",
  "version": "0.1.0",
  "private": true,
  "description": "Offline desktop multilingual chalkboard teacher",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check ui/lessons.js && node --check ui/app.js && npm test",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.chalklingo.desktop",
    "productName": "ChalkLingo",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}